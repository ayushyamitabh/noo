<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash. Without these the OS falls back to the
         full adaptive launcher icon (its white background layer included) on
         a plain window color. A transparent logo on Noo's own background
         reads as part of the app, the way Gmail's splash does. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
